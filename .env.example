# AWS region where you use Bedrock.
MY_AWS_REGION=

# Current Bedrock model. The global profile is supported by AWS for Claude Haiku 4.5.
BEDROCK_MODEL_ID=

# Option A (recommended for local development): use `aws configure` and leave
# these variables unset. The AWS SDK will load your configured profile.
# Option B: fill these values locally. NEVER commit them.
MY_AWS_ACCESS_KEY_ID=
MY_AWS_SECRET_ACCESS_KEY=
MY_AWS_SESSION_TOKEN=

PORT=8000
