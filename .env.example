# AWS region where you use Bedrock.
MY_AWS_REGION=us-east-1

# Current Bedrock model. The global profile is supported by AWS for Claude Haiku 4.5.
BEDROCK_MODEL_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0

# Option A (recommended for local development): use `aws configure` and leave
# these variables unset. The AWS SDK will load your configured profile.
# Option B: uncomment and fill these values locally. NEVER commit them.
# MY_AWS_ACCESS_KEY_ID=YOUR_ACCESS_KEY_ID
# MY_AWS_SECRET_ACCESS_KEY=YOUR_SECRET_ACCESS_KEY
# AWS_SESSION_TOKEN=YOUR_SESSION_TOKEN

PORT=8000
